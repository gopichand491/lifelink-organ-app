{
  "name": "lifelink-selenium-tests",
  "version": "1.0.0",
  "description": "Selenium E2E tests for LifeLink Admin Dashboard",
  "type": "commonjs",
  "scripts": {
    "login": "mocha tests/auth.test.js --timeout 30000",
    "test": "mocha tests/*.test.js --timeout 60000",
    "test-json": "mocha tests/*.test.js --timeout 60000 --reporter json > ../selenium-results.json || true"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "mocha": "^10.3.0",
    "selenium-webdriver": "^4.20.0"
  }
}
